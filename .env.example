# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000          # apps/web: browser-visible API origin (better-auth client + SDK)
DATABASE_URL=postgres://pivot:pivot@localhost:5432/pivot
ENCRYPTION_KEY=change-me-32-bytes-base64          # AES-256-GCM for contact/application profiles
AUTH_SECRET=change-me                              # Better Auth secret
RATE_LIMIT=memory                                  # memory | postgres (apps/api)
TRUSTED_PROXY_HOPS=1                               # apps/api: number of trusted reverse-proxy hops in X-Forwarded-For (0 = trust only the socket address)
ADMIN_EMAILS=                                      # comma-separated allowlist for GET /v1/admin/ops (apps/api); unset = disabled for everyone
METRICS_PORT=9091                                  # apps/worker: /metrics + /healthz

# ---- Adapter selection (fake = offline) ----
AI_PROVIDER=fake              # fake | anthropic
QUEUE=pgboss                  # memory | pgboss — memory is a single-process in-memory queue: it does NOT
                               # deliver jobs across separate OS processes (apps/api enqueuing, apps/worker
                               # consuming, as two real `pnpm dev`/e2e processes), only within one process's
                               # own tests. Use pgboss (real Postgres, DATABASE_URL) for real local dev/e2e.
STORAGE=s3                    # memory | s3  (s3 = MinIO locally)
MEMORY_STORAGE_DIR=           # only used when STORAGE=memory: optional directory that backs the memory
                               # storage adapter with plain files instead of an in-process Map, so separate
                               # processes sharing this path see the same objects (see ADR-070) — a fallback
                               # for environments without a reachable S3/MinIO; leave unset to use STORAGE=s3.
EMAIL=console                 # console | resend
BILLING=fake                  # fake | stripe
WEB_SEARCH=fake               # fake | brave
SPEECH=fake                   # fake | <provider>
ANALYTICS=fake                # fake | posthog
ERRORS=fake                   # fake | sentry
FETCH=guarded                  # guarded | fake — guarded is the SSRF-safe default (ARCHITECTURE §5)
PDF_RENDERER=fake             # fake | gotenberg

# ---- AI (only when AI_PROVIDER=anthropic) ----
ANTHROPIC_API_KEY=
# Set to current model IDs from Anthropic docs at setup time
AI_MODEL_FAST=
AI_MODEL_BALANCED=
AI_MODEL_BEST=

# ---- Storage (MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=pivot-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=            # true | false — optional; defaults to true when S3_ENDPOINT is set (MinIO)

# ---- Rendering ----
GOTENBERG_URL=http://localhost:3005   # infra/docker-compose.yml maps gotenberg to :3005
# GOTENBERG_TIMEOUT_MS=30000    # optional; leave unset for the adapter default (an empty value parses as 0)

# ---- Email ----
SMTP_URL=smtp://localhost:1025   # Mailpit
RESEND_API_KEY=
EMAIL_FROM=Pivot <hello@example.com>

# ---- Billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Other providers ----
BRAVE_SEARCH_API_KEY=
POSTHOG_KEY=
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
