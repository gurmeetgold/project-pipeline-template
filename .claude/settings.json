{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit(./**)",
      "Write(./**)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(corepack *)",
      "Bash(./scripts/gate.sh*)",
      "Bash(GATE_EVALS=1 ./scripts/gate.sh*)",
      "Bash(GATE_E2E=1 ./scripts/gate.sh*)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(service postgresql *)",
      "Bash(service redis-server *)",
      "Bash(psql *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(sed *)",
      "Bash(jq *)",
      "Bash(curl http://localhost*)",
      "Bash(openssl rand *)",
      "Bash(check-tools)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/.next/**)",
      "Read(./**/.turbo/**)",
      "Read(./pnpm-lock.yaml)",
      "Read(./packages/sdk/openapi.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git clean *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx|*.js|*.mjs|*.json|*.css|*.md) pnpm exec prettier --write --log-level silent \"$f\" >/dev/null 2>&1 || true;; esac"
          }
        ]
      }
    ]
  }
}
